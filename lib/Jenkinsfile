pipeline {
    agent any
    environment {
        VERCEL_TOKEN = credentials('vercel_token')
    }
    stages {
        stage('Build Flutter Web') {
            steps {
                // Ensure flutter command is in Windows PATH or provide full path
                bat 'flutter build web --release'
            }
        }
        stage('Deploy to Vercel') {
            steps {
                // Deploys the generated web bundle directly to Vercel
                bat 'npx vercel build/web --prod --token=%VERCEL_TOKEN% --yes'
            }
        }
    }
}